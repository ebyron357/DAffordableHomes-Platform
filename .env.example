# Server-only lead delivery endpoints. Configure these in Vercel; never prefix
# them with NEXT_PUBLIC_ or expose the values in browser code.
CONTACT_LEAD_WEBHOOK_URL=
GHL_CONTACT_LEAD_WEBHOOK_URL=
PROGRAM_LEAD_WEBHOOK_URL=
GHL_PROGRAM_LEAD_WEBHOOK_URL=

