# D'Affordable Homes — environment variable reference.
#
# Copy to `.env.local` for local development. Never commit a filled-in copy:
# CI rejects any committed `.env*` file other than this example.

# ---------------------------------------------------------------------------
# Sanity CMS — see docs/13-cms/SANITY_SETUP.md
# ---------------------------------------------------------------------------

# Public. Without this the Content Lake is never contacted and the blog serves
# the migration seed instead. From https://sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Public. Usually "production".
NEXT_PUBLIC_SANITY_DATASET=production

# Public. Optional; defaults to 2026-08-01.
NEXT_PUBLIC_SANITY_API_VERSION=

# Server only. Viewer token. Required for draft preview; without it the
# draft-mode endpoint returns 503 rather than silently serving published copy.
SANITY_API_READ_TOKEN=

# Server only. Shared secret for the Sanity publish webhook. Must match the
# secret configured on the webhook in sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# GoHighLevel — lead delivery and booking calendar
# See docs/08-integrations/GHL_SETUP.md for the step-by-step setup.
# ---------------------------------------------------------------------------

# Server only. Lead webhooks. Setting ANY ONE of these four delivers every form
# (contact, consultation, NACA, Homes for Heroes, /start): each form tries its
# own variable first and then the others. A value that is empty, not https, or
# not a URL is skipped. Usually this is one GoHighLevel workflow's "Inbound
# Webhook" URL; every payload carries `lead_type` so the workflow can branch.
#
#   /contact, /consultation   LEAD_WEBHOOK_URL first
#   /programs/*               PROGRAM_LEAD_WEBHOOK_URL, then GHL_PROGRAM_LEAD_WEBHOOK_URL
#   /start                    NEXT_STEP_LEAD_WEBHOOK_URL first
# Separate values are only needed to send different forms to different places.
LEAD_WEBHOOK_URL=
PROGRAM_LEAD_WEBHOOK_URL=
GHL_PROGRAM_LEAD_WEBHOOK_URL=
NEXT_STEP_LEAD_WEBHOOK_URL=

# Public by nature (it is the calendar's own link). The GoHighLevel booking
# calendar framed on /consultation: Calendars -> the calendar -> Share / Embed,
# e.g. https://api.leadconnectorhq.com/widget/booking/<id>. Pasting the whole
# embed snippet also works. Unset or invalid means no calendar is shown and the
# Content Security Policy is not widened. Redeploy after changing it.
GHL_BOOKING_URL=

# ---------------------------------------------------------------------------
# Search engine ownership (public tokens, not secrets)
# ---------------------------------------------------------------------------

# The token from Google Search Console's "HTML tag" method, and from Bing
# Webmaster Tools' "Meta tag" method. Pasting the whole <meta> tag also works.
# Unset means no tag is emitted. Redeploy after setting either.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# ClientVerse audit integration
# ---------------------------------------------------------------------------
#
# These are NOT read by the application. They are configured in GitHub under
# Settings -> Secrets and variables -> Actions and consumed by
# .github/workflows/clientverse-audit.yml.
#
#   CLIENTVERSE_ENDPOINT        repository variable  — central audit engine URL
#   CLIENTVERSE_DEPLOYMENT_URL  repository variable  — deployment to audit
#   CLIENTVERSE_TOKEN           repository secret    — bearer token
#
# Until all three are set, the ClientVerse check reports BLOCKED and fails.
