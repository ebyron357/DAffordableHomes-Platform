# D'Affordable Homes — application environment
#
# Copy to .env.local for local development, or set these in the Vercel project
# settings for preview and production. Never commit real values.

# ---------------------------------------------------------------------------
# Canonical origin
# ---------------------------------------------------------------------------
# Used for Studio preview links. The canonical production origin is compiled
# into the application from lib/site.ts (https://daffordablehomes.com).
NEXT_PUBLIC_SITE_URL=https://daffordablehomes.com

# ---------------------------------------------------------------------------
# Sanity CMS
# ---------------------------------------------------------------------------
# Required to connect the application to the Content Lake. Without a project id
# the application serves the committed canonical article dataset and the Studio
# route renders a configuration notice instead of mounting.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01

# Viewer token. Required for Studio draft preview (/api/preview/enable).
SANITY_API_READ_TOKEN=

# Editor/deploy token with write access. Required only by
# scripts/sanity/import-articles.mjs.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity publish webhook posting to /api/revalidate.
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Article routes are statically generated so unknown slugs return a real 404.
# When set, publishing an article also triggers a deployment so a newly
# published slug becomes routable.
VERCEL_DEPLOY_HOOK_URL=

# ---------------------------------------------------------------------------
# Lead delivery (existing integrations)
# ---------------------------------------------------------------------------
LEAD_WEBHOOK_URL=
PROGRAM_LEAD_WEBHOOK_URL=
GHL_PROGRAM_LEAD_WEBHOOK_URL=
